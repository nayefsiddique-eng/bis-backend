# ============================================================
# BIS AI Assistant Backend — Environment Variables Template
# Copy this file to .env and fill in the values.
# ============================================================

# ─────────────────────────────────────────────────────────────
# API Security
# ─────────────────────────────────────────────────────────────
API_KEY=demo-key-123

# ─────────────────────────────────────────────────────────────
# Database & Vector Store
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./bis_assistant.db
VECTOR_DB_TYPE=chroma
VECTOR_DB_URL=./chroma_db

# ─────────────────────────────────────────────────────────────
# Redis & Celery
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─────────────────────────────────────────────────────────────
# Cache TTL Policies (seconds)
# ─────────────────────────────────────────────────────────────
RAG_CACHE_TTL=3600
DOCUMENT_CACHE_TTL=1800

# ─────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
RATE_LIMIT=60

# ─────────────────────────────────────────────────────────────
# LLM
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=mock
LLM_API_KEY=

# ─────────────────────────────────────────────────────────────
# OCR
# ─────────────────────────────────────────────────────────────
OCR_PROVIDER=local    # local | tesseract | paddle | mock

# ─────────────────────────────────────────────────────────────
# Translation Provider Selection
#   indictrans2  → AI4Bharat IndicTrans2 local model (ACTIVE)
#   bhashini     → Bhashini NMT API (API approval pending)
#   auto         → Prefer Bhashini if configured, else IndicTrans2
# ─────────────────────────────────────────────────────────────
TRANSLATION_PROVIDER=indictrans2

# ─────────────────────────────────────────────────────────────
# AI4Bharat IndicTrans2 (active provider)
# Models auto-downloaded from HuggingFace Hub on first run (~800MB each).
# Subsequent starts use the local cache (~/.cache/huggingface/).
#
# INDICTRANS2_DEVICE:
#   auto  → detect CUDA automatically (uses GPU if available, else CPU)
#   cuda  → force GPU (requires NVIDIA CUDA)
#   cpu   → force CPU
#
# INDICTRANS2_BATCH_SIZE:
#   Reduce to 1 on low-memory systems.
# ─────────────────────────────────────────────────────────────
INDICTRANS2_DEVICE=auto
INDICTRANS2_BATCH_SIZE=1

# ─────────────────────────────────────────────────────────────
# Bhashini / ULCA (API approval pending — do NOT remove)
# Register at: https://bhashini.gov.in/ulca/user/register
# Once approved, set TRANSLATION_PROVIDER=bhashini or =auto
# ─────────────────────────────────────────────────────────────
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_PIPELINE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ─────────────────────────────────────────────────────────────
# Security & File Limits
# ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
